<?xml version="1.0"?>

<!--
========================================================================
  Top Level Project File
========================================================================
-->

<project name="TOP LEVEL Build File" basedir="." default="usage">

  <!-- This directory. -->
  <property name="project.name"       value="boostmtree"/>

  <!-- Dependency package.  -->
  <property name="rfsrc.pkg.name"         value="randomForestSRC"/>

  <!-- Install name, gives us flexibility.  --> 
  <property name="project.pkg.name"       value="boostmtree"/>
  
  <property name="project.version"    value="2.0.0"/>
  <property name="project.build"      value="bld20260308"/>
  
  <property name="minimum.version"    value="0.0.0.0"/>
  
  <property environment="env"/>

  <import  file="build.init.xml"/>



  <!--
    ========================================================================
      Internal Target:  Set the trace.
    ========================================================================
  -->

  <!-- CAUTION:  These comments affect the             -->
  <!-- CAUTION:  public build.                         -->

  <!-- CAUTION:  "trace-remove" means ALL TRACE IS REMOVED:         -->
  <target name="trace-remove"> </target>

  <!-- CAUTION:  "trace-active" means THIS TARGET IS ACTIVE:           -->
  <!-- CAUTION:  ACTIVATE THIS TARGET TO TURN ON THE OPTIONS BELOW:    -->  
  <target name="trace-active"> </target>

  
  <!--
    ========================================================================
      Internal target, public-generic
    ========================================================================
  -->
  <target name="public-generic" depends="trace-remove">

    <!-- Filterchains are used before filtersets. -->

    <delete  dir="target/public/"/>

    <mkdir  dir="target/public/"/>
    <mkdir  dir="target/public/src"/>
    <mkdir  dir="target/public/src/main"/>
    <mkdir  dir="target/public/src/main/c/cran"/>
    <mkdir  dir="target/public/src/main/resources"/>
    <mkdir  dir="target/public/src/main/resources/cran"/>
    <mkdir  dir="target/public/src/main/resources/cran/scripts"/>
    <mkdir  dir="target/public/src/main/resources/cran/inst"/>
    <mkdir  dir="target/public/src/main/resources/cran/data"/>
    <mkdir  dir="target/public/src/main/resources/cran/man"/>
    <mkdir  dir="target/public/src/main/resources/cran/R"/>

    <property name="dsmain"  value="src/main/"/>
    <property name="dscran"  value="src/main/resources/cran"/>
    
    <property name="ptmain"  value="target/public/src/main/"/>
    <property name="ptcran"  value="target/public/src/main/resources/cran"/>

    <copy todir="${ptcran}/scripts">
      <fileset dir="${dscran}/scripts">
        <include name="*"/>
      </fileset>
    </copy>
    
    <copy todir="${ptcran}/data">
      <fileset dir="${dscran}/data">
        <include name="*.txt"/>
        <include name="*.RData"/>
	      <include name="*.csv"/>
      </fileset>
    </copy>


    <copy file="${dscran}/NAMESPACE" tofile="${ptcran}/NAMESPACE"> </copy>
    <copy file="${dscran}/DESCRIPTION" tofile="${ptcran}/DESCRIPTION"> </copy>
    <copy file="${dscran}/NEWS.md" tofile="${ptcran}/NEWS.md"> </copy>

    <copy todir="${ptcran}/inst">
      <fileset dir="${dscran}/inst">
        <include name="*"/>
      </fileset>
    </copy>

    <copy todir="${ptcran}/man">
      <fileset dir="${dscran}/man">
        <include name="*.Rd"/>
      </fileset>

      <filterchain>
        <tokenfilter>
          <replacestring from="${http.prefix.token}"  to="${http.prefix}"/>
          <replacestring from="${https.prefix.token}" to="${https.prefix}"/>
        </tokenfilter>
      </filterchain>
    </copy>

    <copy todir="${ptcran}/R">
      <fileset dir="${dscran}/R">
        <include name="*.R"/>
      </fileset>

      <filterchain>
        <tokenfilter>
            <ignoreblank/>
        </tokenfilter>
        <stripjavacomments/>
      </filterchain>
    </copy>


    <copy file="build.public.xml"
          tofile="target/public/build.xml"
          overwrite="true">

      <filterchain>
        <tokenfilter>
          <replacestring from="@@PROJECT_PACKAGE_NAME@@" to="${project.pkg.name}"/>
          <replacestring from="@@RFSRC_PACKAGE_NAME@@"   to="${rfsrc.pkg.name}"/>
          <replacestring from="@@VARPRO_PACKAGE_NAME@@"  to="${varpro.pkg.name}"/>
          <replacestring from="@@PROJECT_VERSION@@"      to="${project.version}"/>
          <replacestring from="@@PROJECT_BUILD@@"        to="${project.build}"/>
          <replacestring from="@@MINIMUM_VERSION@@"      to="${minimum.version}"/>
        </tokenfilter>
      </filterchain>

    </copy>

    <copy file="build.init.xml"
          tofile="target/public/build.init.xml"
          overwrite="true"/>

    <copy file="build.cran.xml"
          tofile="target/public/build.cran.xml"
          overwrite="true"/>

  </target>    


  <!--
    ========================================================================
      SOURCE-SECRET target, Entry Point
    ========================================================================
  -->
  <target name="source-secret" depends="init">
    <zip destfile="../${project.pkg.name}.${project.build}.zip"
         basedir="../"
         includes="${project.name}/**"
         excludes="${project.name}/target/"/>
  </target>

  <!--
    ========================================================================
      PUBLIC target, Entry Point
    ========================================================================
  -->
  <target name="public" depends="init, public-generic"/>

  <!--
    ========================================================================
      SOURCE-CRAN target, Entry Point
    ========================================================================
  -->
  <target name="source-cran"
          depends="init, public-generic, source-cran-generic" />
    
  <target name="source-cran-generic">
    <exec dir="target/public" executable="ant" vmlauncher="FALSE" failonerror="TRUE">
      <arg line="source-cran"/>
    </exec>
  </target>

  
  <!--
    ========================================================================
      BUILD-CRAN target, Entry Point
    ========================================================================
  -->
  <target name="build-cran"
          depends="init, public-generic, build-cran-generic" />

  <target name="build-cran-generic">
    <exec dir="target/public" executable="ant" vmlauncher="FALSE" failonerror="TRUE">
      <arg line="build-cran"/>
    </exec>
  </target>

  <!--
    ========================================================================
      INSTALL-CRAN target, Entry Point
    ========================================================================
  -->
  <target name="install-cran"
          depends="init, public-generic, install-cran-generic" />

  <target name="install-cran-generic">
    <exec dir="target/public" executable="ant" vmlauncher="FALSE" failonerror="TRUE">
      <arg line="install-cran"/>
    </exec>
  </target>


  <!--
    ========================================================================
      CHECK-AS-CRAN target, Entry Point
    ========================================================================
  -->
  <target name="check-as-cran"
          depends="init, public-generic, check-as-cran-generic" />

  <target name="check-as-cran-generic">
    <exec dir="target/public" executable="ant" vmlauncher="FALSE" failonerror="TRUE">
      <arg line="check-as-cran"/>
    </exec>
  </target>

  <!--
    ========================================================================
      Help on usage.  List available targets
    ========================================================================
    -->
  <target name="usage" depends="init">
    <echo message=""/>
    <echo message=" Available targets are:"/>
    <echo message=""/>
    <echo message=" clean"/>
    <echo message=" clean-cran"/>
    <echo message="     --> delete the specific target directory"/>    
    <echo message=""/>
    <echo message=" source-secret"/>
    <echo message="     --> generate a zip file of the source tree"/>
    <echo message=""/>
    <echo message=" source-cran"/>
    <echo message="     --> create the CRAN source package"/>
    <echo message=""/>
    <echo message=" build-cran"/>
    <echo message="     --> build the CRAN package"/>
    <echo message="     --> the tar ball is what you send to CRAN"/>
    <echo message=""/>
    <echo message=" install-cran"/>
    <echo message="     --> install the CRAN package"/>
    <echo message="     --> this is a local install"/>
    <echo message=""/>
    <echo message=" check-as-cran"/>
    <echo message="     --> check the CRAN package"/>
    <echo message="     --> this is a rigorous check"/>
    <echo message=""/>

    <echo message=" public"/>
    <echo message="     --> create the public repository"/>
    <echo message=""/>
    <echo message=""/>
    
    <echo message=" Available development clean targets (USE WITH CAUTION):"/>
    <echo message=""/>
    <echo message=" clean"/>
    <echo message="     --> delete the target directory"/>    
    <echo message=""/>
    <echo message=" clean-quality"/>
    <echo message="     --> delete the test/quality directory"/>    
    <echo message=""/>
    <echo message=" clean-R"/>
    <echo message="     --> delete the test/quality/R directory"/>    
    <echo message=""/>
    <echo message=""/>
    
  </target>

</project>



